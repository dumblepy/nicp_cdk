service : {
  "storePrivateKv" : (blob, nat64) -> (record {
    "aad_len" : nat ;
    "ciphertext_len" : nat ;
    "key_version" : nat ;
    "note_id" : text ;
    "nonce_len" : nat ;
    "owner" : principal ;
  }) ;
  "fetchPrivateKv" : () -> (record {
    "ciphertext_hex" : text ;
    "key_version" : nat ;
    "owner" : principal ;
  }) ;
  "derivePrivateKvKey" : (text, nat64) -> (record {
    "context_label" : text ;
    "encrypted_key_hex" : text ;
    "input_label" : text ;
    "key_version" : nat ;
    "owner" : principal ;
    "public_key_hex" : text ;
  }) ;
};
